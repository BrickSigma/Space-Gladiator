{
    "version": 4,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 11
    },
    "configurePresets": [
        {
            "name": "debug",
            "description": "Debug build",
            "binaryDir": "${sourceDir}/build",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "ASAN_ENABLED": "ON"
            }
        },
      {
        "name": "release",
        "description": "Release build",
        "binaryDir": "${sourceDir}/release",
        "cacheVariables": {
          "CMAKE_BUILD_TYPE": "Release",
          "ASAN_ENABLED": "OFF"
        }
      },
      {
        "name": "min-release",
        "description": "Minimum sized release build",
        "binaryDir": "${sourceDir}/min-release",
        "cacheVariables": {
          "CMAKE_BUILD_TYPE": "MinSizeRel",
          "ASAN_ENABLED": "OFF"
        }
      }
    ]
}